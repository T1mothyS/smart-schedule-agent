# ==================== 用户认证 ====================
# JWT 密钥
JWT_SECRET=replace-with-a-long-random-string
# 可选；未填写时使用 JWT_SECRET 派生验证码 HMAC。
EMAIL_CODE_PEPPER=

# ==================== SMTP / 163 官方邮箱 ====================
# 官方发件邮箱固定为 aicalendarofficial@163.com。
# SMTP_PASS 必须填写 163 邮箱生成的“客户端授权码”，不能填写网页登录密码。
SMTP_HOST=smtp.163.com
SMTP_PORT=465
SMTP_USER=aicalendarofficial@163.com
SMTP_PASS=replace-with-163-client-authorization-code
# 不需要 REMINDER_RECIPIENT_EMAIL：每位用户在右上角“设置”中配置自己的提醒邮箱；
# 未单独配置时，系统使用该用户的注册邮箱。

# ==================== 用户 QQ 邮箱摘要（可选） ====================
# 用于日报服务端只读读取用户 QQ 收件箱的未读摘要；授权码会以 AES-GCM 加密后保存。
# 生产环境必须使用独立于 JWT_SECRET、BACKUP_ENCRYPTION_KEY 的随机长密钥。
MAIL_CREDENTIALS_ENCRYPTION_KEY=replace-with-a-separate-random-mail-encryption-key

# ==================== 邀请码迁移期引导 ====================
# 首次启动且数据库尚未有邀请码记录时导入并保存为哈希；之后以数据库为唯一生效来源。
# 轮换请在管理员面板中按角色手动触发；不要提交真实邀请码。
ADMIN_INVITE_CODE=replace-with-admin-invite-code
USER_INVITE_CODE=replace-with-user-invite-code

# ==================== 服务器配置 ====================
PORT=3000
APP_TIMEZONE=Asia/Shanghai
# 本模板默认可直接用于本地开发；生产部署时改为正式 HTTPS 地址和 production。
APP_URL=http://localhost:5173/today
APP_ENV=development
# 反向代理层数；本地直连保持 0，Nginx 直接代理到本服务时通常为 1。
TRUST_PROXY_HOPS=0
# 后台提醒、通知队列、邮件导入和备份任务默认关闭；仅在唯一生产 worker 上显式开启。
BACKGROUND_JOBS_ENABLED=false
# Electron 安装包是远程安全壳；构建时会把这个公开 URL 写入安装包（不会写入其他 .env 值）。
ELECTRON_APP_URL=https://your-domain.example/today
# Vite 默认只监听本机。如确需局域网调试，显式设置监听地址和唯一允许的主机名。
# VITE_DEV_HOST=0.0.0.0
# VITE_ALLOWED_HOST=calendar-dev.example.lan
# ==================== 加密灾备 / 阿里云 OSS ====================
# 至少 8 位，生产环境请使用独立随机长密钥
BACKUP_ENCRYPTION_KEY=replace-with-a-separate-long-random-string
# Bucket 必须设为私有并开启阻止公共访问；同地域 ECS 优先使用内网 Endpoint
OSS_BUCKET=
OSS_ENDPOINT=oss-cn-beijing-internal.aliyuncs.com
OSS_ACCESS_KEY_ID=
OSS_ACCESS_KEY_SECRET=
# 全站恢复时临时设置为 true，正常运行必须保持 false
MAINTENANCE_MODE=false

# ==================== 邮箱自动导入（可选） ====================
IMAP_HOST=imap.163.com
IMAP_PORT=993
IMAP_USER=aicalendarofficial@163.com
IMAP_PASS=
