# ==================== 用户认证 ====================
# JWT 密钥
JWT_SECRET=replace-with-a-long-random-string

# ==================== SMTP / 163 官方邮箱 ====================
SMTP_HOST=smtp.163.com
SMTP_PORT=465
SMTP_USER=aicalendarofficial@163.com
SMTP_PASS=replace-with-app-password
# REMINDER_RECIPIENT_EMAIL is only a backward-compatible fallback; users configure their own reminder email in Settings

# ==================== 固定邀请码 ====================
# 高权限管理员注册码
ADMIN_INVITE_CODE=replace-with-admin-invite-code
# 普通用户注册码
USER_INVITE_CODE=replace-with-user-invite-code

# ==================== CodeBuddy AI ====================
# CodeBuddy API Key (AI 对话必需)
CODEBUDDY_API_KEY=replace-with-codebuddy-api-key

# ==================== 服务器配置 ====================
PORT=3000
APP_TIMEZONE=Asia/Shanghai
APP_URL=https://your-domain.example/schedule
NODE_ENV=production
# CODEBUDDY_BASE_URL=https://api.codebuddy.cn

# ==================== 加密灾备 / 阿里云 OSS ====================
# 至少 8 位，生产环境请使用独立随机长密钥
BACKUP_ENCRYPTION_KEY=replace-with-a-separate-long-random-string
# Bucket 必须设为私有并开启阻止公共访问；同地域 ECS 优先使用内网 Endpoint
OSS_BUCKET=
OSS_ENDPOINT=oss-cn-beijing-internal.aliyuncs.com
OSS_ACCESS_KEY_ID=
OSS_ACCESS_KEY_SECRET=
# 全站恢复时临时设置为 true，正常运行必须保持 false
MAINTENANCE_MODE=false

# ==================== 邮箱自动导入（可选） ====================
IMAP_HOST=imap.163.com
IMAP_PORT=993
IMAP_USER=aicalendarofficial@163.com
IMAP_PASS=
