# ==================== 用户认证 ====================
# JWT 密钥
JWT_SECRET=replace-with-a-long-random-string

# ==================== SMTP / 163 官方邮箱 ====================
SMTP_HOST=smtp.163.com
SMTP_PORT=465
SMTP_USER=aicalendarofficial@163.com
SMTP_PASS=replace-with-app-password
# REMINDER_RECIPIENT_EMAIL is only a backward-compatible fallback; users configure their own reminder email in Settings

# ==================== 固定邀请码 ====================
# 高权限管理员注册码
ADMIN_INVITE_CODE=replace-with-admin-invite-code
# 普通用户注册码
USER_INVITE_CODE=replace-with-user-invite-code

# ==================== CodeBuddy AI ====================
# CodeBuddy API Key (AI 对话必需)
CODEBUDDY_API_KEY=replace-with-codebuddy-api-key

# ==================== 服务器配置 ====================
PORT=3000
APP_TIMEZONE=Asia/Shanghai
APP_URL=https://your-domain.example/schedule
NODE_ENV=production
# CODEBUDDY_BASE_URL=https://api.codebuddy.cn
