{
  "name": "smart-schedule-agent",
  "version": "0.23.1-260918.2350",
  "description": "跨平台智能日程表 Agent 应用",
  "author": "Smart Schedule Team",
  "license": "MIT",
  "engines": {
    "node": ">=22.12.0"
  },
  "type": "module",
  "main": "dist-electron/main.js",
  "scripts": {
    "dev": "concurrently -k \"npm run dev:server\" \"npm run dev:client\"",
    "dev:server": "tsx watch server/index.ts",
    "dev:client": "vite",
    "dev:electron": "npm run electron:dev",
    "dev:electron:client": "vite",
    "build": "npm run build:client && npm run build:electron",
    "build:client": "vite build",
    "build:electron:code": "tsc -p tsconfig.electron.json",
    "build:electron": "npm run build:electron:code && node scripts/prepare-electron-config.mjs",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.node.json --noEmit && tsc -p tsconfig.electron.json --noEmit",
    "test": "tsx --test server/*.test.ts",
    "test:cross-project": "tsx --test integration/daily-report-cross-project.test.ts",
    "server": "tsx server/index.ts",
    "electron": "electron .",
    "electron:dev": "npm run build:electron:code && concurrently -k \"npm run dev:server\" \"npm run dev:electron:client\" \"npm run electron:dev:start\"",
    "electron:dev:start": "wait-on http://localhost:5173 && electron .",
    "electron:build": "npm run build && electron-builder --projectDir dist-desktop --config ../electron-builder.yml"
  },
  "dependencies": {
    "@tencent-ai/agent-sdk": "^0.3.43",
    "bcryptjs": "^3.0.3",
    "dotenv": "^17.4.1",
    "express": "^4.18.2",
    "imapflow": "^1.4.7",
    "jsonwebtoken": "^9.0.3",
    "katex": "^0.18.7",
    "lucide-react": "^0.563.0",
    "lunar-javascript": "^1.7.7",
    "mailparser": "^3.9.15",
    "mermaid": "^12.0.0",
    "node-cron": "^4.2.1",
    "nodemailer": "^9.0.3",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-router-dom": "^7.13.0",
    "sql.js": "^1.14.1",
    "tdesign-icons-react": "^0.5.0",
    "tdesign-react": "^1.12.0",
    "uuid": "^14.0.1"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/mailparser": "^3.4.6",
    "@types/node": "^20.10.0",
    "@types/node-cron": "^3.0.11",
    "@types/nodemailer": "^8.0.0",
    "@types/react": "^18.2.43",
    "@types/react-dom": "^18.2.17",
    "@types/uuid": "^9.0.7",
    "@vitejs/plugin-react": "^6.1.0",
    "autoprefixer": "^10.5.4",
    "concurrently": "^8.2.2",
    "electron": "^43.4.1",
    "electron-builder": "^26.15.3",
    "less": "^4.3.0",
    "postcss": "^8.5.0",
    "postcss-selector-parser": "^6.1.4",
    "tailwindcss": "^3.4.19",
    "tsx": "^4.6.2",
    "typescript": "^5.3.2",
    "vite": "^8.2.2",
    "wait-on": "^8.0.2"
  },
  "overrides": {
    "deepmerge-ts": "8.0.2",
    "esbuild": "0.28.2"
  }
}
