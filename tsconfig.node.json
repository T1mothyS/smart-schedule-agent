{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM"],
    "skipLibCheck": true,
    "module": "ESNext",
    "moduleResolution": "bundler",
    "allowSyntheticDefaultImports": true,
    "allowImportingTsExtensions": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "types": ["node"],
    "strict": true
  },
  "include": [
    "vite.config.ts",
    "server/**/*.ts",
    "src/utils/scheduleConflict.ts",
    "src/components/calendar/calendarMeta.ts",
    "src/types/**/*.d.ts"
  ]
}
